# Copy to .env (gitignored) and fill in. Never commit real values.
# Only the discovery run calls a model; deterministic replay needs no key.
ANTHROPIC_API_KEY=

# The mock application's sign-in. These are synthetic and public (the mock runs on loopback with
# made-up data); a real deployment would supply real credentials the same way, from the environment.
MOCK_USER=teller01
MOCK_PASS=demo-only
