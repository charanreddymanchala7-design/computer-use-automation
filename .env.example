# Copy to .env (gitignored) and fill in. Never commit real values.
# Only the discovery run calls a model; deterministic replay needs no key.
# Use whichever you have (pick one with `cua run --provider anthropic|gemini|ollama`):
ANTHROPIC_API_KEY=
# A free key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
# `ollama` needs no key: it uses a model running locally (`ollama serve`)

# The mock application's sign-in. These are synthetic and public (the mock runs on loopback with
# made-up data); a real deployment would supply real credentials the same way, from the environment.
MOCK_USER=teller01
MOCK_PASS=demo-only
