{
  "version": 1,
  "tools": [
    {
      "name": "member_lookup",
      "description": "Sign in, find a member by number and read the current share savings balance. Read-only: nothing is changed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string",
            "description": "Member number (five digits)",
            "pattern": "^[0-9]{5}$"
          }
        },
        "required": [
          "member_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "DegradedLocator": {
            "additionalProperties": false,
            "description": "A step that was found, but not by its first-choice strategy: an early sign of UI drift.",
            "properties": {
              "step_id": {
                "title": "Step Id",
                "type": "string"
              },
              "strategy_index": {
                "minimum": 1,
                "title": "Strategy Index",
                "type": "integer"
              },
              "strategy_kind": {
                "title": "Strategy Kind",
                "type": "string"
              }
            },
            "required": [
              "step_id",
              "strategy_index",
              "strategy_kind"
            ],
            "title": "DegradedLocator",
            "type": "object"
          },
          "EscalationInfo": {
            "additionalProperties": false,
            "properties": {
              "request_id": {
                "title": "Request Id",
                "type": "string"
              },
              "reason": {
                "title": "Reason",
                "type": "string"
              },
              "step_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Step Id"
              }
            },
            "required": [
              "request_id",
              "reason"
            ],
            "title": "EscalationInfo",
            "type": "object"
          },
          "EvidenceRefs": {
            "additionalProperties": false,
            "description": "Paths, relative to the run directory, of the richer signals kept for debugging.",
            "properties": {
              "screenshot": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Screenshot"
              },
              "aria_snapshot": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Aria Snapshot"
              },
              "trace": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Trace"
              },
              "log": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Log"
              }
            },
            "title": "EvidenceRefs",
            "type": "object"
          },
          "InterventionRecord": {
            "additionalProperties": false,
            "description": "A person was brought in during the run, and how that ended.",
            "properties": {
              "request_id": {
                "title": "Request Id",
                "type": "string"
              },
              "step_id": {
                "title": "Step Id",
                "type": "string"
              },
              "reason_code": {
                "title": "Reason Code",
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "handed_back",
                  "aborted",
                  "timed_out"
                ],
                "title": "Outcome",
                "type": "string"
              },
              "taken_by": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Taken By"
              },
              "duration_ms": {
                "minimum": 0,
                "title": "Duration Ms",
                "type": "integer"
              },
              "actions": {
                "description": "What the person did, described without what they typed",
                "items": {
                  "type": "string"
                },
                "title": "Actions",
                "type": "array"
              }
            },
            "required": [
              "request_id",
              "step_id",
              "reason_code",
              "outcome",
              "duration_ms"
            ],
            "title": "InterventionRecord",
            "type": "object"
          },
          "RecoveryRecord": {
            "additionalProperties": false,
            "description": "A known condition that was handled without ending the run.",
            "properties": {
              "rule_id": {
                "title": "Rule Id",
                "type": "string"
              },
              "step_id": {
                "title": "Step Id",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "dismiss",
                  "wait_retry"
                ],
                "title": "Kind",
                "type": "string"
              },
              "attempts": {
                "minimum": 1,
                "title": "Attempts",
                "type": "integer"
              }
            },
            "required": [
              "rule_id",
              "step_id",
              "kind",
              "attempts"
            ],
            "title": "RecoveryRecord",
            "type": "object"
          },
          "Status": {
            "enum": [
              "success",
              "business_outcome",
              "escalated",
              "hard_failure"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/$defs/Status"
          },
          "outcome_code": {
            "description": "Machine-readable, always set",
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "title": "Outcome Code",
            "type": "string"
          },
          "capability_id": {
            "title": "Capability Id",
            "type": "string"
          },
          "capability_version": {
            "title": "Capability Version",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "outputs": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Outputs"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Message"
          },
          "failed_step": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Failed Step"
          },
          "expected": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected"
          },
          "observed": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Observed"
          },
          "escalation": {
            "anyOf": [
              {
                "$ref": "#/$defs/EscalationInfo"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "recoveries": {
            "items": {
              "$ref": "#/$defs/RecoveryRecord"
            },
            "title": "Recoveries",
            "type": "array"
          },
          "degraded": {
            "items": {
              "$ref": "#/$defs/DegradedLocator"
            },
            "title": "Degraded",
            "type": "array"
          },
          "interventions": {
            "items": {
              "$ref": "#/$defs/InterventionRecord"
            },
            "title": "Interventions",
            "type": "array"
          },
          "evidence": {
            "$ref": "#/$defs/EvidenceRefs"
          },
          "duration_ms": {
            "minimum": 0,
            "title": "Duration Ms",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "outcome_code",
          "capability_id",
          "capability_version",
          "run_id",
          "duration_ms"
        ],
        "title": "ReplayResult",
        "type": "object"
      },
      "annotations": {
        "title": "Look up a member and read their savings balance",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "cua/version": "1.0.0",
        "cua/digest": "sha256:876701d613efe71bec9849bcdd1c069e69424e1acd64f65153cb459bfe6234a1",
        "cua/outputs": {
          "type": "object",
          "properties": {
            "savings_balance": {
              "type": "string",
              "description": "Current share savings balance, exactly as displayed, for example $2,480.15"
            }
          },
          "required": [
            "savings_balance"
          ],
          "additionalProperties": false
        },
        "cua/requires_secrets": [
          "MOCK_PASS",
          "MOCK_USER"
        ]
      }
    }
  ]
}
